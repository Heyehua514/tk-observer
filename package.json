{
  "name": "tk-observer",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "test": "pnpm --dir apps/web test",
    "typecheck": "pnpm --dir apps/web typecheck",
    "lint": "pnpm --dir apps/web lint",
    "format": "pnpm --dir apps/web format",
    "pb:serve": "./backend/pocketbase serve --dir=backend/pb_data --migrationsDir=backend/pb_migrations --hooksDir=backend/pb_hooks --http=127.0.0.1:8090",
    "pb:migrate": "./backend/pocketbase migrate up --dir=backend/pb_data --migrationsDir=backend/pb_migrations",
    "desktop:dev": "pnpm --dir apps/desktop tauri dev",
    "desktop:build": "pnpm --dir apps/desktop tauri build",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:types": "supabase gen types typescript --local > apps/web/src/types/database.generated.ts && pnpm --dir apps/web exec prettier --write src/types/database.generated.ts",
    "supabase:stop": "supabase stop",
    "supabase:schema:test": "node --test scripts/supabase/schema-inventory.test.mjs",
    "supabase:schema:export": "node scripts/supabase/export-pocketbase-schema.mjs"
  },
  "devDependencies": {
    "supabase": "^2.113.0"
  }
}
